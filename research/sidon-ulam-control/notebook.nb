      RowBox[{"f", "/", "N"}], ")"}]}]},
   {
    RowBox[{"Ulam", 
     RowBox[{"(", 
      RowBox[{"1", ",", "2"}], ")"}]}], 
    RowBox[{"30", ",", "000"}], 
    RowBox[{"404", ",", "381"}], "2.5714", 
    RowBox[{"-", "0.79702"}]},
   {
    RowBox[{"Bose", " ", "Sidon", " ", 
     RowBox[{"(", 
      RowBox[{"q", "=", "30011"}], ")"}]}], 
    RowBox[{"30", ",", "000"}], 
    RowBox[{"1", ",", "800", ",", "600", ",", "122"}], "0.0836", 
    RowBox[{"-", "0.01311"}]},
   {
    RowBox[{"Random", " ", "Control", " ", 
     RowBox[{"(", 
      RowBox[{"mean", " ", "\[PlusMinus]", " ", "\[Sigma]"}], ")"}]}], 
    RowBox[{"30", ",", "000"}], "\[LongDash]", "\[LongDash]", 
    RowBox[{
     RowBox[{"-", "0.01525"}], " ", "\[PlusMinus]", " ", "0.00192"}]}
