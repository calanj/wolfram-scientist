Notebook[{
Cell["Sidon-Ulam Control: Fourier Dip Analysis", "Title",ExpressionUUID->"97692a59-8950-4445-ac86-cea9e7dd454a"],

Cell["Question", "Section",ExpressionUUID->"921b4c6d-5f96-4a06-bb3d-6b2f626bac30"],

Cell["\<\
Do Sidon-set (B\\[Subscript]2 sequence) constructions exhibit deep Fourier \
dips comparable to the Ulam sequence's hidden-\[Alpha] signal?\
\>", "Text",ExpressionUUID->"7a1d6dfd-0143-44b6-89c8-460148971ea4"],

Cell["Results at N = 10,000", "Section",ExpressionUUID->"b941535e-e79a-42bd-96a5-3814a0d78db5"],

Cell["Fourier dip depth (normalized by sequence length):", "Text",ExpressionUUID->"265d6b35-f908-4bcd-ba09-2dfb48aa48ef"],

Cell[BoxData[GridBox[{
   {"Sequence", "N", 
    RowBox[{"Max", " ", "Term"}], 
    RowBox[{"Refined", " ", "X"}], 
    RowBox[{"Dip", " ", "Depth", " ", 
     RowBox[{"(", 
      RowBox[{"f", "/", "N"}], ")"}]}]},
   {
    RowBox[{"Ulam", 
     RowBox[{"(", 
      RowBox[{"1", ",", "2"}], ")"}]}], 
    RowBox[{"10", ",", "000"}], 
    RowBox[{"132", ",", "788"}], "2.5714", 
    RowBox[{"-", "0.79682"}]},
   {
    RowBox[{"Bose", " ", "Sidon", " ", 
     RowBox[{"(", 
      RowBox[{"q", "=", "10007"}], ")"}]}], 
    RowBox[{"10", ",", "000"}], 
    RowBox[{"200", ",", "120", ",", "050"}], "1.7728", 
    RowBox[{"-", "0.02601"}]},
   {
    RowBox[{"Random", " ", "Control", " ", 
     RowBox[{"(", 
      RowBox[{"mean", " ", "\[PlusMinus]", " ", "\[Sigma]"}], ")"}]}], 
    RowBox[{"10", ",", "000"}], "\[LongDash]", "\[LongDash]", 
    RowBox[{
     RowBox[{"-", "0.02513"}], " ", "\[PlusMinus]", " ", "0.00227"}]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Top}}},
  GridBoxDividers->{
   "Rows" -> {{True, False, False, False}}, 
    "Columns" -> {{True, False, False, False, False}}}]], "Output",ExpressionU\
UID->"f83bcdc6-e78a-4eb6-acf9-4e551fc143d0"],

Cell["Results at N = 30,000", "Section",ExpressionUUID->"49ef132f-af95-48d5-97f8-4f9ef8555f23"],

Cell["Fourier dip depth (normalized by sequence length):", "Text",ExpressionUUID->"2ace03fa-879e-41a8-be8f-517023a7d577"],

