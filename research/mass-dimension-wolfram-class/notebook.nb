Notebook[{
Cell["Is single-seed mass dimension a proxy for Wolfram class?", "Title",ExpressionUUID->"4068e765-3b10-4c89-b12d-960534229808"],

Cell["\<\
Wolfram Scientist \[CenterDot] research id mass-dimension-wolfram-class \[CenterDot] elementary cellular \
automata\
\>", "Subtitle",ExpressionUUID->"974744a0-b1a5-4004-81e7-c961f9d314fd"],

Cell["\<\
Headline: No. The best single D-threshold separating class 2 from class 3 \
equals the majority baseline (0.776) \[Dash] zero discriminative power. Both \
classes pile up at D ~ 1. A class-1 rule (254) holds the maximal dimension \
D=2.\
\>", "Text",ExpressionUUID->"19097d7b-f636-44fd-8f0e-d43d85508250"],

Cell["1. Single-seed mass dimension for all 256 rules", "Section",ExpressionUUID->"aa1b305e-4a3b-48d1-88f8-f1ee9fb46d20"],

Cell["\<\
massDimension[rule,10]: slope of log2(live cells) vs log2(rows) for a single \
black cell evolved 2^10 rows. Reused from research 1 (log2 3 to 14 digits on \
rule 90).\
\>", "Text",ExpressionUUID->"88af662c-88f8-430e-a2c7-9f76c05ea2f4"],

Cell[BoxData[
 RowBox[{"<<", "\"\<lib/massDimension.wl\>\""}]], "Input",ExpressionUUID->"07d4c49e-c383-4aae-9338-212c254967a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dims", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"r", "\[Rule]", 
       RowBox[{"massDimension", "[", 
        RowBox[{"r", ",", "10"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "255"}], "}"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"MinMax", "[", 
   RowBox[{"Values", "[", "dims", "]"}], "]"}]}]], "Input",ExpressionUUID->\
"6f09d640-6d64-43b1-9092-bd0a74038a2b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.`", ",", "2.024541892731149`"}], "}"}]], "Output",ExpressionUUID->\
"7b52bc5c-4156-41e7-8ea1-5cae1fab1ba8"],

Cell["2. Operational Wolfram class (random-IC behavior)", "Section",ExpressionUUID->"065f5de6-792f-487c-92b7-5fee10257985"],

Cell["\<\
Class is the typical behavior from RANDOM initial conditions \[Dash] not the \
single seed D measures. lib/wolframClass.wl assigns it from damage spreading \
under a 1-cell perturbation; it scores 27/27 on literature-consensus anchors.\
\
\>", "Text",ExpressionUUID->"cfc4c1d7-8033-4b8e-b76f-6be213e7b6e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<lib/wolframClass.wl\>\""}], ";", 
  RowBox[{"classOf", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"r", "\[Rule]", 
       RowBox[{"wolframClass", "[", "r", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "255"}], "}"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"KeySort", "[", 
   RowBox[{"Counts", "[", 
    RowBox[{"Values", "[", "classOf", "]"}], "]"}], "]"}]}]], "Input",Expressi\
onUUID->"dd02acc2-76c0-40d6-81ea-bd5a431d8b75"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "24"}], ",", 
   RowBox[{"2", "\[Rule]", "177"}], ",", 
   RowBox[{"3", "\[Rule]", "51"}], ",", 
   RowBox[{"4", "\[Rule]", "4"}]}], "\[RightAssociation]"}]], "Output",Express\
ionUUID->"b08c489b-f405-4604-9dd4-4e90878c76c2"],

Cell["3. Does D separate the classes? No.", "Section",ExpressionUUID->"a264e8b1-3709-48ae-8b19-f32bb8cf7551"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"accAt", "[", 
    RowBox[{
     RowBox[{"MaximalBy", "[", 
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"Round", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"d2", ",", "d3"}], "]"}], ",", "0.001`"}], "]"}], "]"}], ",",
        "accAt"}], "]"}], "\[LeftDoubleBracket]", "1", 
     "\[RightDoubleBracket]"}], "]"}], ",", "baseline", ",", 
   RowBox[{"accAt", "[", "1.5`", "]"}]}], "}"}]], "Input",ExpressionUUID->\
"fc68a5b2-fd8d-4d35-8bc3-862d7abd8403"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"best 2v3 acc\"\>", "\[Rule]", "0.776`"}], ",", 
   RowBox[{"\<\"baseline\"\>", "\[Rule]", "0.776`"}], ",", 
   RowBox[{"\<\"naive D>=1.5\"\>", "\[Rule]", "0.732`"}]}], "}"}]], "Output",E\
xpressionUUID->"d343dbeb-55db-427f-ad14-e74b15f17449"],

Cell["\<\
Every class has a column of points on the dashed line D=1; classes 2 and 3 \
both also reach D~2. The distributions interleave rather than band.\
\>", "Text",ExpressionUUID->"61f53371-b9f7-4f73-a9cb-4604606316cb"],

