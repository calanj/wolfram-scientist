   "8", ",", " ", "11", ",", " ", "13", ",", " ", "16", ",", " ", "18", ",", 
   " ", "26", ",", " ", "28", ",", " ", "36", ",", " ", "38", ",", " ", "47", 
   ",", " ", "48", ",", " ", "53", ",", " ", "57", ",", " ", "62", ",", " ", 
   "69"}], "}"}]], "Output",ExpressionUUID->"eb66bb7c-9cf7-43e5-b762-\
337f9ba086d6"]
}, Open  ]],

Cell["The hidden signal", "Section",ExpressionUUID->"89dca3be-d83b-4ea3-b9cb-18bd92b98ccc"],

Cell["Fourier sum scan f_N(x)/N across [0.05, pi]:", "Text",ExpressionUUID->"4ad2aa37-0ef0-4dfa-943b-d6bd502eaea8"],

