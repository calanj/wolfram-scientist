Notebook[{
Cell["Hidden quasi-periodicity in the Ulam sequence", "Title",ExpressionUUID->"d7cb0aad-cf3e-4396-98bf-96adfaaabf03"],

Cell["Abstract", "Section",ExpressionUUID->"44fd421a-3b77-4a73-8703-7407539ba9b4"],

Cell["\<\
Steinerberger (2015) reported a hidden quasi-periodic structure in the Ulam \
sequence A002858. The Fourier sum f_N(x) = Sum cos(x*a_n) exhibits a sharp \
negative dip at alpha ~2.5714 with depth ~-0.8*N. We replicate this at \
N=10^5, verify alpha to 12 digits, test against 100 random controls (Z-score \
-194), and confirm it is Ulam-specific and extraordinarily sharp.\
\>", "Text",ExpressionUUID->"c8cb8667-3efb-41f9-9315-5b9e54f8fbb3"],

Cell["Set-up", "Section",ExpressionUUID->"9bcb89fe-e5cd-44ef-a13c-dde4e93b23dc"],

Cell["\<\
Load and verify the Ulam sequence (100,000 terms, max element 1,351,223):\
\>", "Text",ExpressionUUID->"937ca6fc-a6c7-4b74-a827-b96fdac54dc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ulamTerms", " ", "=", " ", 
   RowBox[{"Import", "[", "\"\<ulam_terms.wxf\>\"", "]"}]}], ";", " ", 
  RowBox[{"Length", "[", "ulamTerms", "]"}]}]], "Input",ExpressionUUID->\
"ea8ca4ed-4f2a-49c3-8b33-99800c225949"],

Cell[BoxData["100000"], "Output",ExpressionUUID->"8b0f47b6-dec8-4837-9b72-d42501662970"]
}, Open  ]],

Cell["First 20 terms match OEIS A002858:", "Text",ExpressionUUID->"f21f94f7-c3ca-4a62-b43d-13b0d8e6fb64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Take", "[", 
  RowBox[{"ulamTerms", ",", " ", "20"}], "]"}]], "Input",ExpressionUUID->\
"ac1a2607-e5f1-4b43-8e86-c838bc93c742"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
