Cell["Epistemic status", "Section",ExpressionUUID->"289c46ce-d847-444a-951c-2c856442bbe7"],

Cell["\<\
Verified: dimensions exact to ~14 digits (mass = 3^k). Conjecture (tested to \
2^10 rows): rule 22 has dimension exactly log2 3 despite not reducing to rule \
90.\
\>", "Text",ExpressionUUID->"5006741f-17f1-41c6-b6b8-a238fb1f9a7c"]
